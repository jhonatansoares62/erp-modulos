# Cofre local do api-whatsapp para ERP-ODONTO (Test Number da Meta).
#
# COMO USAR:
#   cp .secrets/odonto.env.example .secrets/odonto.env
#   # preencha os COLE_AQUI (token, app secret, WABA id, token do túnel, hostname)
#   bash scripts/whatsapp-dev/run-meta.sh     # sobe o api-whatsapp lendo daqui
#   bash scripts/whatsapp-dev/tunnel.sh       # sobe o túnel Cloudflare
#
# NUNCA commitar o .secrets/odonto.env (gitignored via .secrets/*.env).

export WHATSAPP_PHONE_NUMBER_ID=
export WHATSAPP_ACCESS_TOKEN=
export WHATSAPP_APP_SECRET=
export WHATSAPP_VERIFY_TOKEN=
export WABA_ID=
export CLOUDFLARE_TUNNEL_TOKEN=
export WEBHOOK_PUBLIC_HOSTNAME=
export WHATSAPP_ERP_CALLBACK_URL=http://localhost:9198
export API_KEY=odonto-dev-key
export WHATSAPP_META_API_BASE_URL=https://graph.facebook.com/v22.0
