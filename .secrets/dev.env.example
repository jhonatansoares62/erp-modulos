# Cofre local de secrets do api-whatsapp — TRILHA A (Test Number Meta).
#
# COMO USAR:
#   cp dev.env.example dev.env
#   # preenche os 4 valores conforme passos da Trilha A
#   source dev.env
#   ./mvnw spring-boot:run -pl api-whatsapp -Dskip.frontend=true
#
# NUNCA commitar dev.env (gitignored em /.gitignore).

# Phone Number ID do Test Number — Meta UI: WhatsApp > API Setup > "From"
# Eh o ID numerico (~15 digitos), NAO o numero de telefone.
export WHATSAPP_PHONE_NUMBER_ID=

# Token temporario 24h (Trilha A) — Meta UI: WhatsApp > API Setup > "Temporary access token"
# Em producao (Trilha B) trocar pelo System User permanent token.
export WHATSAPP_ACCESS_TOKEN=

# App Secret — Meta UI: App Settings > Basic > "App Secret" > Show
# Usado pelo HmacValidator pra validar X-Hub-Signature-256 do webhook inbound.
export WHATSAPP_APP_SECRET=

# Verify Token — NOS escolhemos. String aleatoria 32+ chars.
# Gerar com: openssl rand -hex 32
# Vai bater com o que voce colar na Meta UI quando configurar o webhook.
export WHATSAPP_VERIFY_TOKEN=

# URL interna do ERP-MUDAS pra callback async (rota Phase 3).
# Default localhost:8090 (porta prod) ou 8091 (porta dev).
export WHATSAPP_ERP_CALLBACK_URL=http://localhost:8091
