# Cofre local de secrets do api-whatsapp — TRILHA B (cliente real, ex: fvparana-mudas).
#
# Vai sendo populado conforme cada passo da Trilha B fecha:
#   - PHONE_NUMBER_ID/ACCESS_TOKEN: depois que numero dedicado for registrado + System User permanente gerado
#   - APP_SECRET: igual ao da Trilha A (mesmo app Meta) OU diferente se voce criar app dedicado por cliente
#   - VERIFY_TOKEN: pode ser o mesmo da Trilha A ou outro (recomendado: outro, pra isolar)
#   - WABA_ID: anotar logo que o WABA for criado, eh necessario pro POST /subscribed_apps
#
# COMO USAR (em producao roda como env vars do servico WinSW, NAO source manual).
# Pra teste local apontando pro WABA real:
#   cp fvparana.env.example fvparana.env
#   source fvparana.env
#   ./mvnw spring-boot:run -pl api-whatsapp

export WHATSAPP_PHONE_NUMBER_ID=
export WHATSAPP_ACCESS_TOKEN=
export WHATSAPP_APP_SECRET=
export WHATSAPP_VERIFY_TOKEN=
export WHATSAPP_ERP_CALLBACK_URL=http://localhost:8090

# Extras Trilha B (NAO consumidos pelo backend hoje, so referencia operacional):
export WABA_ID=
export DISPLAY_NAME=
export DISPLAY_PHONE_NUMBER=
